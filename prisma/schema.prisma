generator client {
  provider        = "prisma-client-js"
  // CI builds on debian (GH Actions), Vercel runs rhel — ship both engines
  binaryTargets   = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  loginToken     String   @unique
  githubRepo     String?  // BYO: user's paired private repo (owner/name)
  githubTokenEnc String?  // BYO: AES-256-GCM encrypted fine-grained PAT
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MemBox {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots       Snapshot[]
  webhooks        Webhook[]
  shareTokens     ShareToken[]
  ttlEntries      TtlEntry[]
  analyticsEvents AnalyticsEvent[]
}

model Snapshot {
  id        String   @id @default(cuid())
  boxId     String
  label     String?
  data      String   // JSON snapshot of file listing + sizes
  createdAt DateTime @default(now())

  box       MemBox   @relation(fields: [boxId], references: [id], onDelete: Cascade)
}

model Webhook {
  id        String   @id @default(cuid())
  boxId     String
  url       String
  events    String   // JSON array: ["write","delete","upload"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  box       MemBox   @relation(fields: [boxId], references: [id], onDelete: Cascade)
}

model ShareToken {
  id         String    @id @default(cuid())
  boxId      String
  token      String    @unique
  permission String    @default("read") // "read" or "write"
  label      String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  box        MemBox    @relation(fields: [boxId], references: [id], onDelete: Cascade)
}

model TtlEntry {
  id         String   @id @default(cuid())
  boxId      String
  filePath   String
  ttlSeconds Int
  expiresAt  DateTime

  box        MemBox   @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@unique([boxId, filePath])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  boxId     String
  slug      String
  method    String
  path      String?
  statusCode Int
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  box       MemBox   @relation(fields: [boxId], references: [id], onDelete: Cascade)
}
